# Local benchmark only. Copy to .env before starting infrastructure.
POSTGRES_DB=site_x_benchmark
POSTGRES_USER=site_x_benchmark
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_PORT=54329
DATABASE_URL=postgresql://site_x_benchmark:replace-with-local-only-password@127.0.0.1:54329/site_x_benchmark

# Auth.js local benchmark settings. Never reuse these values outside this stack.
AUTH_SECRET=replace-with-generated-local-test-secret
AUTH_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_EMAIL_FROM=benchmark@benchmark.test

# Local Mailpit endpoints for future magic-link testing.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
