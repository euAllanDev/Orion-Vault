{
  "name": "site-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "infra:up": "docker compose --env-file .env -f docker-compose.benchmark.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f docker-compose.benchmark.yml down --remove-orphans",
    "infra:reset": "docker compose --env-file .env -f docker-compose.benchmark.yml down -v --remove-orphans",
    "infra:status": "docker compose --env-file .env -f docker-compose.benchmark.yml ps",
    "infra:smoke": "node scripts/infra-smoke.mjs",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "test:integration": "npm run db:seed && node --test tests/integration/persistence.test.mjs",
    "test:auth": "npm run db:migrate && npm run db:seed && npm run build && node --test tests/integration/auth.test.mjs",
    "test:rbac": "npm run db:migrate && npm run db:seed && tsx --test tests/integration/rbac.test.ts",
    "test:api": "npm run db:migrate && npm run db:seed && npm run build && node --test tests/integration/api.test.mjs",
    "test:frontend": "npm run db:migrate && npm run db:seed && npm run build && node --test tests/integration/frontend.test.mjs",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.1",
    "next": "15.5.9",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "prisma": "^6.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
