generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum Role {
  OWNER
  ADMIN
  RESEARCHER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum SessionMethod {
  INTERVIEW
  OBSERVATION
  USABILITY_TEST
}

enum SessionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum EvidenceKind {
  QUOTE
  OBSERVATION
  NOTE
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.Citext
  name               String?             @db.VarChar(120)
  image              String?             @map("image_url")
  emailVerified      DateTime?           @map("email_verified")
  createdAt          DateTime            @default(now()) @map("created_at")
  memberships        Membership[]
  projects           Project[]           @relation("ProjectCreator")
  accounts           Account[]
  verificationTokens VerificationToken[]
  evidenceRequests   EvidenceRequest[]
}

model Workspace {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique
  name             String
  plan             Plan              @default(FREE)
  createdAt        DateTime          @default(now()) @map("created_at")
  memberships      Membership[]
  projects         Project[]
  evidenceRequests EvidenceRequest[]
}

model Membership {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        Role
  joinedAt    DateTime  @default(now()) @map("joined_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  name         String        @db.VarChar(100)
  objective    String
  status       ProjectStatus @default(ACTIVE)
  createdBy    String        @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  participants Participant[]
  sessions     Session[]
  themes       Theme[]

  @@index([workspaceId, status])
}

model Participant {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  displayName   String
  consentStatus ConsentStatus
  metadata      Json?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions      Session[]
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  participantId String?       @db.Uuid
  scheduledAt   DateTime
  method        SessionMethod
  status        SessionStatus @default(PLANNED)
  guide         String?
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant   Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  evidences     Evidence[]

  @@index([projectId, scheduledAt])
}

model Evidence {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String            @db.Uuid
  text             String
  kind             EvidenceKind
  timestampSeconds Int?
  tags             String[]          @default([])
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  session          Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  themes           ThemeEvidence[]
  requests         EvidenceRequest[]
}

model Theme {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @db.Uuid
  title      String
  summary    String
  confidence Confidence
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidences  ThemeEvidence[]
}

model ThemeEvidence {
  themeId    String   @db.Uuid
  evidenceId String   @db.Uuid
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([themeId, evidenceId])
}

model EvidenceRequest {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  key         String    @db.VarChar(128)
  evidenceId  String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence    Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId, key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}
