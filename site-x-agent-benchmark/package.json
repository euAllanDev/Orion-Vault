{
  "name": "site-x-agent-benchmark",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "infra:up": "docker compose -f docker-compose.benchmark.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.benchmark.yml down",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.16.2",
    "next": "^15.5.25",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "tsx": "^4.19.3",
    "prisma": "^6.16.2",
    "@types/nodemailer": "^7.0.1"
  },
  "prisma": { "seed": "node prisma/seed.mjs" }
}
